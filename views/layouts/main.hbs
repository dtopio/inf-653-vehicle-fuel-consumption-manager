<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{{title}}</title>
	<style>
		body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f8; }
		header { background: #1f2937; color: #fff; padding: 12px 20px; }
		main { max-width: 900px; margin: 20px auto; background: #fff; padding: 20px; border-radius: 8px; }
		a { color: #2563eb; text-decoration: none; }
		table { width: 100%; border-collapse: collapse; margin-top: 12px; }
		th, td { border: 1px solid #d1d5db; padding: 8px; text-align: left; }
		th { background: #f9fafb; }
		form { display: grid; gap: 10px; max-width: 420px; }
		input, select, button { padding: 8px; }
		.error { color: #b91c1c; }
		.actions { margin: 10px 0 15px; display: flex; gap: 12px; }
	</style>
</head>
<body>
	<header>
		<strong>Vehicle Fuel Consumption Manager</strong>
	</header>
	<main>
		{{{body}}}
	</main>
</body>
</html>
