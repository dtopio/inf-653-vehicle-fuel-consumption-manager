<div class="header-row">
  <div class="page-header" style="margin-bottom: 0;">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Welcome back, {{username}}</p>
  </div>
  <a href="/add-record" class="btn btn-primary">+ Add Record</a>
</div>

<div class="stats-row">
  <div class="stat-card">
    <span class="stat-icon">📋</span>
    <div class="stat-label">Total Records</div>
    <div class="stat-value">{{records.length}}</div>
    <div class="stat-unit">entries logged</div>
  </div>
  <div class="stat-card">
    <span class="stat-icon">💰</span>
    <div class="stat-label">Total Spent</div>
    <div class="stat-value">${{sumField records "totalCost"}}</div>
    <div class="stat-unit">all time</div>
  </div>
  <div class="stat-card">
    <span class="stat-icon">⛽</span>
    <div class="stat-label">Total Liters</div>
    <div class="stat-value">{{sumField records "liters"}}</div>
    <div class="stat-unit">liters fueled</div>
  </div>
  <div class="stat-card">
    <span class="stat-icon">🛣️</span>
    <div class="stat-label">Total Distance</div>
    <div class="stat-value">{{sumField records "distance"}}</div>
    <div class="stat-unit">km traveled</div>
  </div>
</div>

<div class="summary-grid">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Weekly Summary</span>
    </div>
    <div class="card-body" style="padding-top: 10px;">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Week</th>
              <th>Total Cost</th>
            </tr>
          </thead>
          <tbody>
            {{#if weeklySummary.length}}
              {{#each weeklySummary}}
              <tr>
                <td>{{this.period}}</td>
                <td>${{this.totalCost}}</td>
              </tr>
              {{/each}}
            {{else}}
              <tr><td colspan="2" class="td-empty">No weekly data yet</td></tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <span class="card-title">Monthly Summary</span>
    </div>
    <div class="card-body" style="padding-top: 10px;">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Month</th>
              <th>Total Cost</th>
            </tr>
          </thead>
          <tbody>
            {{#if monthlySummary.length}}
              {{#each monthlySummary}}
              <tr>
                <td>{{this.period}}</td>
                <td>${{this.totalCost}}</td>
              </tr>
              {{/each}}
            {{else}}
              <tr><td colspan="2" class="td-empty">No monthly data yet</td></tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">All Records</span>
  </div>
  <div class="card-body" style="padding-top: 10px; padding-bottom: 0;">
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Vehicle</th>
            <th>Liters</th>
            <th>Distance</th>
            <th>Cost</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#if records.length}}
            {{#each records}}
            <tr>
              <td>{{this.date}}</td>
              <td>
                <span class="badge {{#if (eq this.vehicleType "Car")}}badge-car{{else}}badge-moto{{/if}}">
                  {{#if (eq this.vehicleType "Car")}}🚗{{else}}🏍️{{/if}}
                  {{this.vehicleType}}
                </span>
              </td>
              <td>{{this.liters}} L</td>
              <td>{{this.distance}} km</td>
              <td>${{this.totalCost}}</td>
              <td>
                <div style="display:flex; gap:6px; align-items:center;">
                  <a href="/records/{{this.id}}/edit" class="btn btn-ghost btn-sm">Edit</a>
                  <form method="POST" action="/records/{{this.id}}/delete">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            {{/each}}
          {{else}}
            <tr><td colspan="6" class="td-empty">No records yet. Add your first fuel record!</td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>
