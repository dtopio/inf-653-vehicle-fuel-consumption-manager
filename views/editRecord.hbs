<a href="/dashboard" class="back-link">← Back to Dashboard</a>

<div class="page-header">
  <h1 class="page-title">Edit Fuel Record</h1>
  <p class="page-subtitle">Update an existing fuel consumption entry</p>
</div>

{{#if error}}
<div class="alert alert-error">
  <span>⚠️</span>
  <span>{{error}}</span>
</div>
{{/if}}

<div class="form-card">
  <form method="POST" action="/records/{{record.id}}/edit">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <div class="form-grid">
      <div class="form-group form-full">
        <label class="form-label" for="date">Date</label>
        <input class="form-control" id="date" name="date" type="date" value="{{record.date}}" required />
      </div>

      <div class="form-group form-full">
        <label class="form-label" for="vehicleType">Vehicle Type</label>
        <select class="form-control" id="vehicleType" name="vehicleType" required>
          <option value="Car" {{#if (eq record.vehicleType "Car")}}selected{{/if}}>🚗 Car</option>
          <option value="Motorcycle" {{#if (eq record.vehicleType "Motorcycle")}}selected{{/if}}>🏍️ Motorcycle</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="liters">Liters</label>
        <input class="form-control" id="liters" name="liters" type="number" min="0" step="0.01" value="{{record.liters}}" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="distance">Distance (km)</label>
        <input class="form-control" id="distance" name="distance" type="number" min="0" step="0.01" value="{{record.distance}}" required />
      </div>

      <div class="form-group form-full">
        <label class="form-label" for="totalCost">Total Cost ($)</label>
        <input class="form-control" id="totalCost" name="totalCost" type="number" min="0" step="0.01" value="{{record.totalCost}}" required />
      </div>
    </div>

    <hr class="divider" />
    <div class="form-actions">
      <a href="/dashboard" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Update Record</button>
    </div>
  </form>
</div>
