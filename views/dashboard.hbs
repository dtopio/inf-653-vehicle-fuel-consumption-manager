<h1>Dashboard</h1>
<p>Welcome, {{username}}</p>

<div class="actions">
	<a href="/add-record">Add Record</a>
</div>

<table>
	<thead>
		<tr>
			<th>Date</th>
			<th>Vehicle Type</th>
			<th>Liters</th>
			<th>Distance (km)</th>
			<th>Total Cost</th>
		</tr>
	</thead>
	<tbody>
		{{#if records.length}}
			{{#each records}}
				<tr>
					<td>{{this.date}}</td>
					<td>{{this.vehicleType}}</td>
					<td>{{this.liters}}</td>
					<td>{{this.distance}}</td>
					<td>{{this.totalCost}}</td>
				</tr>
			{{/each}}
		{{else}}
			<tr>
				<td colspan="5">No records yet.</td>
			</tr>
		{{/if}}
	</tbody>
</table>
