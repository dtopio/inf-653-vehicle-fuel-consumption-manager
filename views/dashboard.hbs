<h1>Dashboard</h1>
<p>Welcome, {{username}}</p>

<div class="actions">
	<a href="/add-record">Add Record</a>
	<form method="POST" action="/logout" style="display: inline;">
		<input type="hidden" name="_csrf" value="{{csrfToken}}" />
		<button type="submit">Logout</button>
	</form>
</div>

<h2>Fuel Expenditure Summary</h2>
<div class="summary-grid">
	<div>
		<h3>By Week</h3>
		<table>
			<thead>
				<tr>
					<th>Week</th>
					<th>Total Cost</th>
				</tr>
			</thead>
			<tbody>
				{{#if weeklySummary.length}}
					{{#each weeklySummary}}
						<tr>
							<td>{{this.period}}</td>
							<td>{{this.totalCost}}</td>
						</tr>
					{{/each}}
				{{else}}
					<tr>
						<td colspan="2">No weekly data yet.</td>
					</tr>
				{{/if}}
			</tbody>
		</table>
	</div>

	<div>
		<h3>By Month</h3>
		<table>
			<thead>
				<tr>
					<th>Month</th>
					<th>Total Cost</th>
				</tr>
			</thead>
			<tbody>
				{{#if monthlySummary.length}}
					{{#each monthlySummary}}
						<tr>
							<td>{{this.period}}</td>
							<td>{{this.totalCost}}</td>
						</tr>
					{{/each}}
				{{else}}
					<tr>
						<td colspan="2">No monthly data yet.</td>
					</tr>
				{{/if}}
			</tbody>
		</table>
	</div>
</div>

<h2>All Records</h2>

<table>
	<thead>
		<tr>
			<th>Date</th>
			<th>Vehicle Type</th>
			<th>Liters</th>
			<th>Distance (km)</th>
			<th>Total Cost</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		{{#if records.length}}
			{{#each records}}
				<tr>
					<td>{{this.date}}</td>
					<td>{{this.vehicleType}}</td>
					<td>{{this.liters}}</td>
					<td>{{this.distance}}</td>
					<td>{{this.totalCost}}</td>
					<td>
						<a href="/records/{{this.id}}/edit">Edit</a>
						<form method="POST" action="/records/{{this.id}}/delete" style="display: inline; margin-left: 6px;">
							<input type="hidden" name="_csrf" value="{{../csrfToken}}" />
							<button type="submit">Delete</button>
						</form>
					</td>
				</tr>
			{{/each}}
		{{else}}
			<tr>
				<td colspan="6">No records yet.</td>
			</tr>
		{{/if}}
	</tbody>
</table>
